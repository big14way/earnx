# Copy to .env (gitignored) and fill in. Used by the Foundry scripts in contracts/.
# Load with:  set -a && source .env && set +a

# Deployer and verifier keys (testnet only). The verifier approves invoices; it can be the deployer.
DEPLOYER_PRIVATE_KEY=
VERIFIER_PRIVATE_KEY=
# Optional: grant VERIFIER_ROLE to a different address at deploy time
VERIFIER_ADDRESS=
# Throwaway wallet that submits the sample invoices in contracts/demo (script/Seed.s.sol)
DEMO_EXPORTER_PRIVATE_KEY=

# RPC endpoints (public defaults shown)
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Optional: verify on Arbiscan as well as Blockscout (Etherscan v2 multichain key)
ETHERSCAN_API_KEY=
